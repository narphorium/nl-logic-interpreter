# System One unifies sentences: Jev, or a Jev-compatible server
# TypeSafe API key for Jev (https://docs.typesafe.ai); optional with SYSTEM_ONE_MODEL_ENDPOINT
TYPESAFE_API_KEY=
# Optional: a Jev-compatible server to use instead of TypeSafe's API (default https://api.typesafe.ai)
# SYSTEM_ONE_MODEL_ENDPOINT=http://127.0.0.1:8080
# Optional: jev-latest (default) or jev-preview
# SYSTEM_ONE_MODEL=jev-latest
# Optional: seconds to wait for each answer before retrying (default 10)
# SYSTEM_ONE_TIMEOUT_SECONDS=10

# System Two reads plain-English questions: Claude, or a model served by Ollama
# Claude API key (https://platform.claude.com); not needed with SYSTEM_TWO_MODEL_ENDPOINT
CLAUDE_API_KEY=
# Optional: an Ollama server to use instead of Claude; SYSTEM_TWO_MODEL is then required
# SYSTEM_TWO_MODEL_ENDPOINT=http://localhost:11434
# Optional: the model that reads questions (default claude-haiku-4-5 with Claude)
# SYSTEM_TWO_MODEL=claude-haiku-4-5
